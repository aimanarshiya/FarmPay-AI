# FarmPay AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# --------------------------------------------------
# Server Configuration
# --------------------------------------------------
PORT=8000
FRONTEND_BASE_URL=http://localhost:5173

# --------------------------------------------------
# MySQL Database (MySQL 8.0)
# --------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=farmpay_app
DB_PASSWORD=your_db_password
DB_NAME=farmpay_ai

# --------------------------------------------------
# Authentication (JWT)
# --------------------------------------------------
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------
# AI Integration — Groq (primary), Gemini (optional), Claude (optional)
# --------------------------------------------------
# PRIMARY: Groq (OpenAI-compatible endpoint)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OPTIONAL: Google Gemini (secondary fallback)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OPTIONAL: Anthropic Claude (tertiary fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --------------------------------------------------
# PayPal REST API v2 (Sandbox)
# --------------------------------------------------
# Developer portal: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox

# --------------------------------------------------
# Demo Seeding (Optional - Local Development Only)
# --------------------------------------------------
FARMPAY_ENABLE_DEMO_SEED=false
DEMO_FARMER_PASSWORD=
DEMO_BUYER_PASSWORD=
DEMO_ADMIN_PASSWORD=
