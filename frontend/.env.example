# FarmPay AI — Frontend Environment Variables Template
# Copy this file to .env.local and update the values.
# NEVER commit .env.local to Git.

# FastAPI backend URL — no trailing slash
VITE_API_URL=http://127.0.0.1:8000

# Local judge quick-fill is available only in Vite development mode and when
# explicitly enabled. Set these from the isolated demo database, never from
# production credentials. Leave disabled for production builds.
VITE_DEMO_MODE=false
VITE_DEMO_FARMER_EMAIL=
VITE_DEMO_FARMER_PASSWORD=
VITE_DEMO_BUYER_EMAIL=
VITE_DEMO_BUYER_PASSWORD=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
